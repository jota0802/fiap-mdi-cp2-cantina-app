{
  "name": "@cantina/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "db:generate": "drizzle-kit generate",
    "db:push": "tsx --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs push",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "create-staff": "tsx --env-file-if-exists=.env src/scripts/create-staff.ts",
    "db:reset": "tsx --env-file-if-exists=.env src/db/reset.ts"
  },
  "dependencies": {
    "@cantina/shared": "workspace:*",
    "@electric-sql/pglite": "^0.2.0",
    "@hono/node-server": "^1.13.0",
    "@hono/zod-validator": "^0.4.0",
    "@node-rs/argon2": "^2.0.0",
    "@paralleldrive/cuid2": "^2.2.0",
    "drizzle-orm": "^0.36.0",
    "hono": "^4.6.0",
    "jose": "^5.9.0",
    "pg": "^8.13.0",
    "pino": "^9.5.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.0",
    "@types/supertest": "^6.0.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.28.0",
    "pino-pretty": "^11.3.0",
    "supertest": "^7.0.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
